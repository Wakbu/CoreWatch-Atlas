{
  "Atlas": {
    "Server": {
      "DatabasePath": "data/corewatch-atlas.db"
    },
    "Registration": {
      "TokenLifetimeMinutes": 15
    },
    "ServerApi": {
      "OfflineAfterSeconds": 45,
      "SnapshotRetentionDays": 30,
      "CleanupIntervalMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
