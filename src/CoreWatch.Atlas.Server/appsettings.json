{
  "Atlas": {
    "Server": {
      "DatabasePath": "data/corewatch-atlas.db"
    },
    "Registration": {
      "TokenLifetimeMinutes": 15
    },
    "AgentInstaller": {
      "AgentPackagePath": "/downloads/corewatch-atlas-agent.zip"
    },
    "AgentUpdate": {
      "Enabled": false,
      "Version": "",
      "PackageUrl": "",
      "Sha256": ""
    },
    "ServerUpdate": {
      "Enabled": false,
      "Version": "",
      "PackageUrl": "",
      "Sha256": "",
      "StatePath": "data/updates",
      "CheckIntervalMinutes": 360
    },
    "GitHubRelease": {
      "Enabled": true,
      "Repository": "Wakbu/CoreWatch-Atlas",
      "CacheMinutes": 15
    },
    "SmtpReport": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "From": "",
      "To": "",
      "SendHourUtc": 0,
      "AttachCsv": true,
      "AttachPdf": true
    },
    "ServerApi": {
      "OfflineAfterSeconds": 45,
      "SnapshotRetentionDays": 30,
      "CleanupIntervalMinutes": 60
    },
    "OperatorAuthentication": {
      "SessionMinutes": 30,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "Security": {
      "RequireHttps": true,
      "AllowLoopbackHttp": true,
      "DataProtectionKeyPath": "data/data-protection-keys",
      "HstsMaxAgeDays": 365
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
